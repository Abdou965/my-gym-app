        "refs": ["schoenfeld2016freq"],
    },
    "Full Body (3 أيام)": {
        "level": "مبتدئ–متوسط", "days": 3, "goal": "لياقة عامة وقوة",
        "who": "من لديه وقت محدود.",
        "why": "تكرار عالٍ لكل عضلة بحجم معتدل.",
