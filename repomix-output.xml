          {% else %}background:var(--bg4);color:var(--txt2){% endif %}">
          {{ '↑' if diff > 0 else ('↓' if diff < 0 else '=') }} {{ diff|abs }} كجم
        </span>
      {% endif %}
      <div style="font-size:9px;color:var(--txt2);margin-top:3px">{{ last.date.strftime("%Y-%m-%d") }}</div>
    </div>
  </div>
{% else %}
  <div style="font-size:11px;color:var(--txt2);text-align:center;padding:6px 0">لا يوجد وزن مسجل بعد</div>
{% endif %}
