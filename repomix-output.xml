  {{ ref_list(refs(s.refs), "المراجع") }}
</div>
{% endfor %}

<div class="sec"><span>بدائل الأطعمة</span></div>
<div class="card">
  {% for cat, rows in swaps.items() %}
  <div style="font-size:11px;font-weight:900;color:var(--ac);margin:4px 0">{{ cat }}</div>
  <ul class="blist">{% for r in rows %}<li>{{ r }}</li>{% endfor %}</ul>
  {% endfor %}
</div>

<script>
document.querySelectorAll(".goal-chip").forEach(c=>c.addEventListener("click",()=>{
  document.querySelectorAll(".goal-chip").forEach(x=>x.classList.toggle("on",x===c));
}));
// احفظ مدخلات النموذج محلياً لتسهيل العودة (اختياري، يتجاهل الأخطاء)
(function(){
  const f=document.getElementById("nut-form"),K="ironcore-nut";
  try{const d=JSON.parse(localStorage.getItem(K)||"{}");
    for(const [n,v] of Object.entries(d)){const els=f.querySelectorAll(`[name="${n}"]`);
      els.forEach(el=>{if(el.type==="radio"){el.checked=el.value===v;el.closest("label")?.classList.toggle("on",el.checked);}
        else if(!(n==="weight"&&el.value)) el.value=v;});}
  }catch(e){}
  f.addEventListener("input",()=>{try{localStorage.setItem(K,JSON.stringify(Object.fromEntries(new FormData(f))));}catch(e){}});
  f.addEventListener("change",()=>{try{localStorage.setItem(K,JSON.stringify(Object.fromEntries(new FormData(f))));}catch(e){}});
})();
</script>
{% endblock %}
