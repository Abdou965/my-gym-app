def lk(key, sets, reps, rest, rir, note=""):
    return (ex(key), sets, {
        "min_reps": reps[0], "max_reps": reps[1],
        "rest_min": rest[0], "rest_max": rest[1],
        "rir_target": rir, "note": note,
    })


