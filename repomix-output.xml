"""Evidence-based knowledge base for IronCore: exercise technique guides,
training-science principles, nutrition rules, and the reference list
every recommendation cites (see references.py)."""
</file>

<file path="app/knowledge/exercises.py">
"""Exercise technique library: one detailed, evidence-based guide per
exercise in seed_data._E (same keys).

Each guide holds:
  target / secondary  : primary and secondary muscles
  level / equipment   : difficulty and what you need
  setup               : the starting position, step by step
  eccentric           : the lowering (negative) phase
  concentric          : the lifting (positive) phase
  breathing           : how to breathe and brace
  tempo               : suggested tempo "eccentric-pause-concentric-pause" in seconds
  mistakes            : common mistakes and how to fix them
  safety              : injury-avoidance points
  evidence            : what recent research says about this exercise
  alternatives        : substitutes when equipment or pain is an issue
  refs                : ids from references.REFS

Guides are general education, not a medical prescription: pain that is
sharp, worsening or lasting needs a qualified clinician.
"""

# ── عبارات مشتركة ───────────────────────────────────────────
B_HEAVY = ("خذ نفساً عميقاً إلى البطن (لا إلى الصدر) قبل النزول، وشدّ عضلات الجذع كأنك تستعد لضربة، "
           "وثبّت النفس خلال التكرار (مناورة فالسالفا)، ثم أخرجه بعد تجاوز أصعب نقطة أو في الأعلى. "
           "إن كان لديك ارتفاع ضغط أو مشكلة قلبية أو في العين فاستبدلها بزفير مستمر بطيء أثناء الدفع.")
B_MOD = ("شهيق هادئ أثناء النزول (المرحلة السلبية)، وزفير متحكَّم به أثناء الدفع أو السحب. "
         "حافظ على شدّ خفيف للبطن ولا تحبس النفس لفترة طويلة.")
B_ISO = "تنفّس بإيقاع منتظم: زفير مع الانقباض وشهيق مع العودة. لا تحبس النفس في تمارين العزل الخفيفة."

T_COMPOUND = "2-1-1-0"   # نزول 2ث، توقف قصير، صعود قوي ~1ث
T_ISO = "2-1-1-1"        # مع توقف في الانقباض
T_STRETCH = "3-1-1-0"    # نزول أبطأ وتوقف في وضع الإطالة

