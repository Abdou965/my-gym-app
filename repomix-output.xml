def macros(key: str, grams: float) -> dict:
    name, p, c, f, fib = FOODS[key]
    k = grams / 100.0
    return {"p": p * k, "c": c * k, "f": f * k, "fib": fib * k,
            "kcal": (p * 4 + c * 4 + f * 9) * k}


