      <div class="exic">⚡</div>
      <div class="exin"><div class="exn">{{ link.exercise.name }}</div><div class="exm">{{ link.exercise.muscle_group }}</div></div>
      <div class="exb">{{ link.target_sets }}×{{ link.exercise.min_reps }}–{{ link.exercise.max_reps }}</div>
