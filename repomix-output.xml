<file path="templates/history_detail.html">
{% extends "base.html" %}
{% block content %}
{% if not workout %}
<div class="empty">الجلسة غير موجودة</div>
{% else %}
<div style="font-size:10px;color:var(--txt2);margin-bottom:8px">{{ workout.date.strftime("%Y-%m-%d %H:%M") }}</div>
<h2 style="margin-bottom:8px">{{ workout.day_name }}</h2>
<div class="s3" style="margin-bottom:12px">
  <div class="sbox"><div class="sval" style="font-size:20px">{{ workout.volume|round }}</div><div class="slbl">كجم</div></div>
  <div class="sbox"><div class="sval" style="font-size:20px">{{ (workout.duration_seconds/60)|round }}</div><div class="slbl">دقيقة</div></div>
  <div class="sbox"><div class="sval" style="font-size:20px">{{ detail|map(attribute='sets')|map('length')|sum }}</div><div class="slbl">مجموعة</div></div>
</div>

{% for item in detail %}
<div class="card">
  <div style="font-size:12px;font-weight:700;color:var(--ac);margin-bottom:5px">{{ item.exercise.name }}</div>
  {% for s in item.sets %}
  <div style="font-size:11px;color:var(--txt2);padding:2px 0;display:flex;gap:10px">
    <span style="color:var(--txt3)">{{ loop.index }}</span>
    <span>{{ s.weight or "—" }} كجم</span>
    <span>× {{ s.reps or "—" }}</span>
    {% if s.rir is not none %}<span style="color:var(--txt3)">RIR {{ s.rir }}</span>{% endif %}
    {% if not s.is_effective %}<span style="color:var(--txt3)">(إحماء)</span>{% endif %}
  </div>
  {% endfor %}
</div>
{% endfor %}

{% if workout.notes %}
<div class="card" style="font-size:12px;color:var(--txt2);font-style:italic">"{{ workout.notes }}"</div>
{% endif %}
{% endif %}
{% endblock %}
</file>

<file path="templates/history.html">
{% extends "base.html" %}
{% block content %}
<h2 style="margin-bottom:11px">السجل</h2>
{% if not workouts %}
<div class="empty">لا توجد جلسات بعد.<br>ابدأ تدريبك الأول!</div>
{% else %}
{% for w in workouts %}
<a href="/history/{{ w.id }}" class="hc">
  <div class="hd">{{ w.date.strftime("%Y-%m-%d %H:%M") }}</div>
  <div class="hn">{{ w.day_name }}</div>
  <div class="hs">
    <div class="hst"><b>{{ w.volume|round }}</b> كجم</div>
    <div class="hst"><b>{{ (w.duration_seconds/60)|round }}</b> د</div>
    {% if w.readiness_score %}<div class="hst">جاهزية: <b>{{ w.readiness_score }}/5</b></div>{% endif %}
  </div>
  {% if w.notes %}<div style="font-size:11px;color:var(--txt2);margin-top:5px;font-style:italic">"{{ w.notes }}"</div>{% endif %}
</a>
{% endfor %}
{% endif %}
{% endblock %}
</file>

<file path="templates/index.html">
{% extends "base.html" %}
{% block content %}
{% if today_day %}
<a href="/workout" class="hero">
  <div class="hero-lbl">{{ today_label }} — {{ now().strftime("%Y-%m-%d") }}</div>
  <div class="hero-name">{{ today_day.name }}</div>
  <div class="hero-sub">{% if today_day.is_rest %}يوم راحة وتعافٍ 🧘{% elif today_day.is_cardio %}كارديو حر: {{ today_day.muscles }} 🏃‍♂️{% else %}العضلات: {{ today_day.muscles }}{% endif %}</div>
  <div class="hero-chip">{% if today_day.is_rest %}🧘 يوم راحة{% elif today_day.is_cardio %}🏃‍♂️ كارديو اليوم{% else %}▶ ابدأ الجلسة ({{ today_day.exercises|length }} تمارين){% endif %}</div>
</a>
{% else %}
<div class="empty">لم يتم اختيار برنامج بعد.<br><a href="/workout" style="color:var(--ac)">اذهب لإعداد برنامجك →</a></div>
{% endif %}

<div class="s3">
  <div class="sbox"><div class="sval">{{ stats.sessions }}</div><div class="slbl">جلسة</div></div>
  <div class="sbox"><div class="sval">{{ (stats.volume/1000)|round(1) if stats.volume>=1000 else stats.volume|round }}{{ 'k' if stats.volume>=1000 else '' }}</div><div class="slbl">كجم إجمالي</div></div>
  <div class="sbox"><div class="sval">{{ stats.week }}</div><div class="slbl">هذا الأسبوع</div></div>
</div>

<div class="sec">الوزن اليومي</div>
<div id="weight-preview">{% include "components/weight_preview.html" %}</div>
<form hx-post="/weight" hx-target="#weight-preview" hx-swap="innerHTML" style="display:flex;gap:7px;margin-top:7px">
  <input class="inp" type="number" step="0.1" name="weight" placeholder="الوزن اليوم (كجم)" required>
  <button class="btn btn-y btn-sm" type="submit">تسجيل</button>
</form>

<div class="sec">الحجم الفعّال هذا الأسبوع (لكل عضلة)</div>
<div class="card">
  {% if weekly_muscle %}
    {% for muscle, count in weekly_muscle.items() %}
    <div class="bar-row">
      <div class="bar-lbl">{{ muscle }}</div>
      <div class="bar-wrap"><div class="bar-fill" style="width:{{ (count/max_muscle_count*100)|round|int }}%"></div></div>
      <div class="bar-val">{{ count }}</div>
    </div>
    {% endfor %}
  {% else %}
    <div style="font-size:11px;color:var(--txt2)">لا توجد بيانات كافية بعد — ابدأ أول جلسة</div>
  {% endif %}
</div>

<div class="sec">آخر جلسة</div>
{% if last_session %}
<a href="/history/{{ last_session.id }}" class="hc">
  <div class="hd">{{ last_session.date.strftime("%Y-%m-%d %H:%M") }}</div>
  <div class="hn">{{ last_session.day_name }}</div>
  <div class="hs">
    <div class="hst"><b>{{ last_session.volume|round }}</b> كجم</div>
    <div class="hst"><b>{{ (last_session.duration_seconds/60)|round }}</b> د</div>
    {% if last_session.readiness_score %}<div class="hst">جاهزية: <b>{{ last_session.readiness_score }}/5</b></div>{% endif %}
  </div>
  {% if last_session.notes %}<div style="font-size:11px;color:var(--txt2);margin-top:5px;font-style:italic">"{{ last_session.notes }}"</div>{% endif %}
</a>
{% else %}
<div class="empty">لا توجد جلسات بعد<br>اذهب إلى «البرنامج» وابدأ أول تدريب 💪</div>
{% endif %}
{% endblock %}
</file>

<file path="templates/session.html">
{% extends "base.html" %}
{% block content %}
<form method="post" action="/session/{{ workout.id }}/readiness" style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
  <span class="rdy-pill">⚡ جاهزية اليوم</span>
  <select class="inp" name="score" onchange="this.form.submit()" style="padding:6px 10px;font-size:12px;width:auto;flex:1">
    {% for n, lb in [(1,'منهك جداً'),(2,'متعب'),(3,'عادي'),(4,'جيد'),(5,'ممتاز')] %}
    <option value="{{ n }}" {{ 'selected' if workout.readiness_score == n }}>{{ n }} — {{ lb }}</option>
    {% endfor %}
  </select>
</form>
<div id="exercise-panel-wrap">
  {% include "components/exercise_panel.html" %}
</div>

<div class="r2" style="gap:7px;margin-top:7px">
  <button class="btn btn-r" onclick="document.getElementById('finish-modal').style.display='flex'">إنهاء الجلسة</button>
  <button class="btn btn-o" onclick="document.getElementById('timer-modal').style.display='flex'">⏱ مؤقت الراحة</button>
</div>

<!-- FINISH MODAL -->
<div id="finish-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(6px);z-index:300;align-items:flex-end;justify-content:center">
  <div class="sheet" style="border-radius:26px 26px 0 0;padding:16px 14px 34px;width:100%;max-width:480px;border:1px solid var(--bdr2)">
    <div style="width:30px;height:3px;background:var(--bg4);border-radius:2px;margin:0 auto 14px"></div>
    <div style="font-size:15px;font-weight:900;margin-bottom:12px">🏆 إنهاء الجلسة</div>
    <form method="post" action="/session/{{ workout.id }}/finish">
      <label class="inp-lbl">تقييم الجاهزية / التعافي (1-5)</label>
      <select class="inp" name="readiness_score" style="margin-bottom:10px">
        <option value="">— بدون تقييم —</option>
        <option value="1" {{ 'selected' if workout.readiness_score == 1 }}>1 — منهك جداً</option>
        <option value="2" {{ 'selected' if workout.readiness_score == 2 }}>2 — متعب</option>
        <option value="3" {{ 'selected' if workout.readiness_score == 3 }}>3 — عادي</option>
        <option value="4" {{ 'selected' if workout.readiness_score == 4 }}>4 — جيد</option>
        <option value="5" {{ 'selected' if workout.readiness_score == 5 }}>5 — ممتاز</option>
      </select>
      <label class="inp-lbl">ملاحظة على الجلسة (اختياري)</label>
      <textarea class="inp" name="notes" placeholder="كيف كانت الجلسة؟" style="min-height:70px;margin-bottom:12px"></textarea>
      <button class="btn btn-y" type="submit">💾 حفظ الجلسة</button>
    </form>
    <button class="btn btn-o" style="margin-top:7px;font-size:12px" onclick="document.getElementById('finish-modal').style.display='none'">العودة للجلسة</button>
  </div>
</div>

<!-- TIMER MODAL -->
<div id="timer-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(6px);z-index:300;align-items:flex-end;justify-content:center">
  <div class="sheet" style="border-radius:26px 26px 0 0;padding:16px 14px 34px;width:100%;max-width:480px;border:1px solid var(--bdr2)">
    <div style="width:30px;height:3px;background:var(--bg4);border-radius:2px;margin:0 auto 14px"></div>
    <div style="font-size:15px;font-weight:900;margin-bottom:12px">⏱ مؤقت الراحة</div>
    <div id="timer-disp" style="font-family:'Barlow Condensed',sans-serif;font-size:88px;font-weight:900;text-align:center;color:var(--ac);line-height:1;padding:14px 0">01:30</div>
    <div style="display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin:8px 0">
      <button class="dchip" onclick="TM.set(30)">30ث</button>
      <button class="dchip on" onclick="TM.set(90)">90ث</button>
      <button class="dchip" onclick="TM.set(120)">2د</button>
      <button class="dchip" onclick="TM.set(180)">3د</button>
    </div>
    <div class="r2" style="gap:7px;margin-top:10px">
      <button class="btn btn-y" id="timer-tog" onclick="TM.toggle()">▶ ابدأ</button>
      <button class="btn btn-o" onclick="document.getElementById('timer-modal').style.display='none'">✕ إغلاق</button>
    </div>
  </div>
</div>

<script>
const TM={base:90,rem:90,running:false,iv:null,
  get $d(){return document.getElementById("timer-disp");},
  set(s){this.stop();this.base=s;this.rem=s;this._r();
    document.querySelectorAll("#timer-modal .dchip").forEach(b=>b.classList.remove("on"));
    event.target.classList.add("on");},
  start(){if(this.running)return;this.running=true;document.getElementById("timer-tog").textContent="⏸ إيقاف";
    this.iv=setInterval(()=>{if(this.rem>0)this.rem--;this._r();
      if(this.rem<=0){this.stop();setTimeout(()=>{this.rem=this.base;this._r();},1200);
        try{const c=new(window.AudioContext||window.webkitAudioContext)();
          [0,.15,.3].forEach(t=>{const o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);
            o.frequency.value=880;g.gain.setValueAtTime(.3,c.currentTime+t);
            g.gain.exponentialRampToValueAtTime(.001,c.currentTime+t+.12);
            o.start(c.currentTime+t);o.stop(c.currentTime+t+.12);});}catch(e){}
      }},1000);},
  stop(){clearInterval(this.iv);this.running=false;document.getElementById("timer-tog").textContent="▶ ابدأ";},
  toggle(){this.running?this.stop():this.start();},
  _r(){const m=Math.floor(Math.max(0,this.rem)/60),s=Math.max(0,this.rem)%60;
    this.$d.textContent=String(m).padStart(2,"0")+":"+String(s).padStart(2,"0");}
};
window.addEventListener("beforeunload",e=>{e.preventDefault();e.returnValue="";});
</script>
{% endblock %}
</file>

<file path="templates/tools.html">
{% extends "base.html" %}
{% block content %}
<h2 style="margin-bottom:13px">الأدوات</h2>

<div class="sec">حاسبة 1RM — أقصى وزن (Brzycki)</div>
<div class="card">
  <div class="r2" style="gap:8px;margin-bottom:8px">
    <div><label class="inp-lbl">الوزن (كجم)</label>
      <input class="inp" type="number" step="0.5" name="weight" id="orm-w"
             hx-post="/tools/1rm" hx-trigger="input changed delay:300ms" hx-include="#orm-r"
             hx-target="#orm-result" hx-swap="innerHTML"></div>
    <div><label class="inp-lbl">التكرارات</label>
      <input class="inp" type="number" name="reps" id="orm-r"
             hx-post="/tools/1rm" hx-trigger="input changed delay:300ms" hx-include="#orm-w"
             hx-target="#orm-result" hx-swap="innerHTML"></div>
  </div>
  <div id="orm-result"></div>
</div>

<div class="sec">BMR / TDEE — السعرات اليومية</div>
<div class="card">
  <div class="r2" style="gap:8px;margin-bottom:8px">
    <div><label class="inp-lbl">الوزن (كجم)</label><input class="inp" type="number" id="b-w" oninput="calcBMR()" placeholder="80"></div>
    <div><label class="inp-lbl">الطول (سم)</label><input class="inp" type="number" id="b-h" oninput="calcBMR()" placeholder="175"></div>
    <div><label class="inp-lbl">العمر</label><input class="inp" type="number" id="b-a" oninput="calcBMR()" placeholder="25"></div>
    <div><label class="inp-lbl">الجنس</label>
      <select class="inp" id="b-g" onchange="calcBMR()"><option value="m">ذكر</option><option value="f">أنثى</option></select>
    </div>
  </div>
  <label class="inp-lbl">مستوى النشاط</label>
  <select class="inp" id="b-act" onchange="calcBMR()">
    <option value="1.2">مستقر (لا رياضة)</option>
    <option value="1.375">خفيف (1–3 أيام)</option>
    <option value="1.55" selected>معتدل (3–5 أيام)</option>
    <option value="1.725">نشيط (6–7 أيام)</option>
    <option value="1.9">مكثف جداً</option>
  </select>
  <div class="tres" id="bmr-res" style="display:none;background:var(--bg3);border-radius:8px;padding:13px;text-align:center;margin-top:9px;border:1px solid var(--bdr)">
    <div style="font-family:'Barlow Condensed',sans-serif;font-size:48px;font-weight:900;color:var(--ac)" id="bmr-v">—</div>
    <div style="font-size:11px;color:var(--txt2)">سعرة / يوم (TDEE)</div>
    <div id="bmr-goals" class="r3" style="margin-top:10px"></div>
  </div>
</div>

<div class="sec">نسبة الدهون — Navy Method</div>
<div class="card">
  <div class="r2" style="gap:8px;margin-bottom:8px">
    <div><label class="inp-lbl">خصر (سم)</label><input class="inp" type="number" id="f-wa" oninput="calcBF()" placeholder="85"></div>
    <div><label class="inp-lbl">رقبة (سم)</label><input class="inp" type="number" id="f-ne" oninput="calcBF()" placeholder="38"></div>
    <div><label class="inp-lbl">ورك — إناث (سم)</label><input class="inp" type="number" id="f-hi" oninput="calcBF()" placeholder="اختياري"></div>
    <div><label class="inp-lbl">طول (سم)</label><input class="inp" type="number" id="f-ht" oninput="calcBF()" placeholder="175"></div>
  </div>
  <div class="tres" id="bf-res" style="display:none;background:var(--bg3);border-radius:8px;padding:13px;text-align:center;margin-top:9px;border:1px solid var(--bdr)">
    <div style="font-family:'Barlow Condensed',sans-serif;font-size:48px;font-weight:900;color:var(--ac)" id="bf-v">—</div>
    <div style="font-size:11px;color:var(--txt2)">% نسبة الدهون المقدرة</div>
    <div id="bf-cat" style="margin-top:5px;font-size:12px;color:var(--txt2)"></div>
  </div>
</div>

<script>
function calcBMR(){
  const w=parseFloat(document.getElementById("b-w").value),h=parseFloat(document.getElementById("b-h").value),
        a=parseFloat(document.getElementById("b-a").value),g=document.getElementById("b-g").value,
        act=parseFloat(document.getElementById("b-act").value),res=document.getElementById("bmr-res");
  if(!w||!h||!a||w<20||h<100||a<10){res.style.display="none";return;}
  const bmr=g==="m"?10*w+6.25*h-5*a+5:10*w+6.25*h-5*a-161, tdee=Math.round(bmr*act);
  document.getElementById("bmr-v").textContent=tdee; res.style.display="block";
  document.getElementById("bmr-goals").innerHTML=[[Math.round(tdee-500),"حرق دهون","var(--red)"],[tdee,"صيانة","var(--ac)"],
    [Math.round(tdee+300),"بناء عضل","var(--grn)"]].map(([v,l,c])=>
    `<div style="background:var(--bg4);border-radius:6px;padding:8px"><div style="font-size:17px;font-weight:900;color:${c}">${v}</div><div style="font-size:9px;color:var(--txt2)">${l}</div></div>`).join("");
}
function calcBF(){
  const wa=parseFloat(document.getElementById("f-wa").value),ne=parseFloat(document.getElementById("f-ne").value),
        hi=parseFloat(document.getElementById("f-hi").value)||0,ht=parseFloat(document.getElementById("f-ht").value),res=document.getElementById("bf-res");
  if(!wa||!ne||!ht){res.style.display="none";return;}
  if(wa<=ne){document.getElementById("bf-v").textContent="!";document.getElementById("bf-cat").textContent="الخصر يجب أن يكون أكبر من الرقبة";res.style.display="block";return;}
  let bf=hi>0?163.205*Math.log10(wa+hi-ne)-97.684*Math.log10(ht)-78.387:86.01*Math.log10(wa-ne)-70.041*Math.log10(ht)+36.76;
  bf=Math.max(2,Math.min(55,bf));
  document.getElementById("bf-v").textContent=bf.toFixed(1);
  const cats=[[6,"أقل من المعدل ⚠️"],[14,"رياضي ممتاز 🏆"],[18,"لياقة ممتازة 💪"],[25,"لياقة جيدة ✅"],[32,"متوسط"],[38,"فوق المتوسط"]];
  let cat="مرتفع — يُنصح بالتخفيف";
  for(const [lim,lbl] of cats){if(bf<lim){cat=lbl;break;}}
  document.getElementById("bf-cat").textContent="التصنيف: "+cat; res.style.display="block";
}
</script>
{% endblock %}
</file>

<file path="templates/workout.html">
{% extends "base.html" %}
{% block content %}
{% if error == "rest_day" %}
<div class="card" style="border-right:3px solid var(--red);font-size:12px;color:var(--red);margin-bottom:10px">
  ⚠️ لا يمكن بدء جلسة في يوم راحة. اختر يوماً آخر من الأيام أدناه.
</div>
{% elif error == "cardio_day" %}
<div class="card" style="border-right:3px solid var(--cy);font-size:12px;color:var(--cy);margin-bottom:10px">
  🏃‍♂️ يوم الكارديو لا يحتاج تتبع مجموعات — مارس نشاطك الحر واستمتع.
</div>
{% endif %}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:11px">
  <h2>البرنامج</h2>
</div>

<label class="inp-lbl">البرنامج</label>
<select class="inp" style="margin-bottom:10px"
        hx-post="/workout/select-program" hx-trigger="change" hx-target="#day-panel-wrap" hx-swap="innerHTML"
        name="program_id">
  {% for p in programs %}
  <option value="{{ p.id }}" {{ 'selected' if program and p.id == program.id }}>{{ p.name }}</option>
  {% endfor %}
</select>

<div id="day-panel-wrap">
  {% include "components/day_panel.html" %}
</div>

<div class="sec" style="margin-top:18px">
  تمارين مخصصة
</div>
<form hx-post="/exercises" hx-target="#custom-ex-list" hx-swap="innerHTML" style="margin-bottom:10px">
  <input class="inp" name="name" placeholder="اسم التمرين" required style="margin-bottom:6px">
  <div class="r3" style="gap:6px;margin-bottom:6px">
    <input class="inp" name="muscle_group" placeholder="العضلة">
    <input class="inp" type="number" name="sets" placeholder="مجموعات" value="3">
    <input class="inp" name="tip" placeholder="نصيحة">
  </div>
  <div class="r2" style="gap:6px;margin-bottom:6px">
    <input class="inp" type="number" name="min_reps" placeholder="أقل تكرار" value="8">
    <input class="inp" type="number" name="max_reps" placeholder="أعلى تكرار" value="12">
  </div>
  <button class="btn btn-o" type="submit">+ إضافة تمرين مخصص</button>
</form>
<div id="custom-ex-list">
  {% include "components/custom_ex_list.html" %}
</div>
{% endblock %}
</file>

<file path="README.md">
# IronCore — نظام التدريب الشخصي (Python Edition)

تطبيق ويب محلي لتتبع تمارين كمال الأجسام، مبني على **FastAPI + SQLite + HTMX**،
بدون أي تكلفة أو اشتراك، ويعمل بالكامل من هاتفك على شبكة الواي فاي المنزلية.

## المميزات

- 4 برامج تدريب جاهزة: PPL / Upper-Lower / Bro Split / Full Body
- محرك **التدرج المضاعف (Double Progression)** يقترح تلقائياً متى ترفع الوزن
- حساب **1RM** بمعادلة Brzycki
- فلترة **المجموعات الفعالة** (RIR ≤ 3) لحساب الحجم الأسبوعي الحقيقي لكل عضلة
- تمارين مخصصة، متتبع وزن الجسم، سجل كامل لكل جلسة
- تحديثات فورية بدون إعادة تحميل الصفحة (HTMX)
- قابل للتثبيت كتطبيق (PWA) على شاشة الهاتف الرئيسية

## التشغيل (خطوة بخطوة)

### 1. تثبيت المتطلبات

يتطلب Python 3.11 أو أحدث.

```bash
cd ironcore-app
python -m venv venv
source venv/bin/activate        # على Windows: venv\Scripts\activate
pip install -r requirements.txt
```

### 2. تشغيل الخادم

```bash
uvicorn app.main:app --host 0.0.0.0 --port 8000
```

عند أول تشغيل، سيُنشئ التطبيق تلقائياً ملف `ironcore.db` (قاعدة بيانات SQLite)
ويملأه بالبرامج والتمارين الافتراضية — لا حاجة لأي إعداد يدوي.

### 3. الوصول من الحاسوب

افتح المتصفح على: **http://localhost:8000**

### 4. الوصول من الهاتف (نفس شبكة الواي فاي)

1. اعرف عنوان IP المحلي لحاسوبك:
   - Windows: `ipconfig` (ابحث عن IPv4 Address)
   - Mac/Linux: `ifconfig` أو `ip addr` (ابحث عن inet)
   - مثال: `192.168.1.5`
2. من متصفح الهاتف، افتح: `http://192.168.1.5:8000`
3. تأكد من أن الحاسوب والهاتف على **نفس شبكة الواي فاي**.

### 5. تثبيت كتطبيق (PWA) على الهاتف

**Android (Chrome):** القائمة (⋮) ← "إضافة إلى الشاشة الرئيسية"
**iPhone (Safari):** زر المشاركة 📤 ← "إضافة إلى الشاشة الرئيسية"

## هيكل المشروع

```
ironcore-app/
├── app/
│   ├── main.py          # المسارات (Routes) وربط FastAPI
│   ├── database.py       # اتصال SQLite
│   ├── models.py         # جداول قاعدة البيانات (SQLAlchemy)
│   ├── schemas.py         # نماذج Pydantic
│   ├── logic.py           # 1RM + التدرج المضاعف + المجموعات الفعالة
│   ├── crud.py            # عمليات القراءة/الكتابة
│   └── seed_data.py       # بيانات البرامج والتمارين الافتراضية
├── templates/              # صفحات HTML (Jinja2 + HTMX)
│   ├── base.html
│   ├── index.html          # لوحة التحكم
│   ├── workout.html        # اختيار البرنامج/اليوم
│   ├── session.html        # الجلسة النشطة
│   ├── tools.html           # الحاسبات
│   ├── history.html / history_detail.html
│   └── components/          # أجزاء HTMX الجزئية
├── static/
│   ├── manifest.json         # إعدادات PWA
│   ├── sw.js                  # Service Worker (offline caching)
│   └── icons/                  # أيقونات التطبيق
├── requirements.txt
└── ironcore.db                # يُنشأ تلقائياً عند أول تشغيل
```

## المحرك العلمي (`app/logic.py`)

### 1RM — معادلة Brzycki
```
1RM = الوزن × 36 / (37 - التكرارات)
```

### التدرج المضاعف (Double Progression)
لكل تمرين نطاق تكرارات مستهدف (مثلاً 6–8). القاعدة:
- إذا وصلت لكل المجموعات الفعالة إلى الحد الأعلى للتكرارات **وكان RIR ≤ 2** →
  يُقترح رفع الوزن في الجلسة القادمة بمقدار `increment_weight` الخاص بالتمرين.
- إن لم تصل → يبقى الوزن كما هو مع التركيز على زيادة التكرارات أولاً.

### المجموعات الفعالة (Effective Sets)
مجموعة تُحتسب في الحجم الأسبوعي فقط إذا كان **RIR ≤ 3** (أي قريبة من الفشل)،
فتُستبعد مجموعات الإحماء تلقائياً من إحصائية "الحجم الفعّال لكل عضلة".

## ملاحظات

- قاعدة البيانات ملف واحد (`ironcore.db`) — يمكن نسخه احتياطياً بسهولة.
- لا حاجة لإنترنت بعد التشغيل الأول (باستثناء تحميل الخطوط من Google Fonts وHTMX من CDN
  في المرة الأولى؛ يمكن استبدالها بنسخ محلية لعمل offline كامل إن رغبت).
- لتشغيل التطبيق دائماً في الخلفية على جهاز منزلي، استخدم `pm2` أو `systemd` أو ببساطة
  شغّله داخل `screen`/`tmux`.
